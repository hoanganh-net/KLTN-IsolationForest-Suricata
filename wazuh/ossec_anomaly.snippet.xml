<!--
  ĐẶT TRÊN: Wazuh manager, trong /var/ossec/etc/ossec.conf.
  Ba thay đổi dưới đây (giữ nguyên phần còn lại của file):

  (1) SỬA integration custom-telegram SẴN CÓ của nhánh signature: thêm <group>suricata</group>
      để nó CHỈ gửi cảnh báo signature, KHÔNG gửi cảnh báo anomaly (vì group anomaly không chứa
      chuỗi "suricata"). Thay khối custom-telegram hiện tại bằng khối (1) dưới đây.
      LƯU Ý: sau khi thêm filter này, custom-telegram chỉ còn gửi cảnh báo nhóm Suricata; nếu
      trước đây anh muốn nó gửi cả cảnh báo khác (vuln, SCA...) thì cân nhắc.

  (2) THÊM integration custom-telegram-anomaly: bot/chat thứ 2, chỉ gửi các cảnh báo thuộc nhóm
      anomaly_notify (100305, 100306, 100311, 100312). Các rule 100301-100304 chỉ mang anomaly_event
      để Wazuh đếm, không gửi Telegram.

  (3) Active Response cho rule 100312: dùng suricata-drop theo suricata-drop.config.snippet.xml
      (IPS chạy AF_PACKET inline nên firewall-drop/iptables không chặn được luồng).

  Sau khi sửa: sudo systemctl restart wazuh-manager
-->

<!-- Quy uoc truong (giong custom-telegram cua ban):  <hook_url> = BOT TOKEN,  <api_key> = CHAT_ID. -->

<!-- (1) custom-telegram signature: GIU NGUYEN <hook_url>/<api_key> hien tai cua ban (token/chat_id
     cua bot signature), CHI THEM <group>suricata</group> de khong gui canh bao anomaly. -->
<integration>
  <name>custom-telegram</name>
  <hook_url>TOKEN_BOT_SIGNATURE_GIU_NGUYEN</hook_url>
  <api_key>CHATID_SIGNATURE_GIU_NGUYEN</api_key>
  <group>suricata</group>
  <level>7</level>
  <alert_format>json</alert_format>
</integration>

<!-- (2) custom-telegram-anomaly: bot THU 2, chi cac canh bao can bao (nhom anomaly_notify). -->
<integration>
  <name>custom-telegram-anomaly</name>
  <hook_url>TOKEN_BOT_ANOMALY</hook_url>
  <api_key>CHATID_BOT_ANOMALY</api_key>
  <group>anomaly_notify</group>
  <level>7</level>
  <alert_format>json</alert_format>
</integration>

<!-- (3) Active Response: xem suricata-drop.config.snippet.xml (rule 100312 -> suricata-drop tren agent IPS). -->
