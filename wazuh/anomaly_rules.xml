<!--
  DAT TREN: Wazuh manager. Tha file nay vao /var/ossec/etc/rules/.
  Dai ID 100300-100312 rieng de KHONG trung nhanh signature.
  Telegram:
    - custom-telegram        loc <group>suricata</group>       -> nhanh signature
    - custom-telegram-anomaly loc <group>anomaly_notify</group> -> chi canh bao DANG BAO
      (100305 diem cao lan dau, 100306 web, 100307/100308/100309 Behavior-IF, 100311 tai dien, 100312 CRITICAL).
      Base 100302/303/304 KHONG mang anomaly_notify nen fire ngam de DEM ma khong lam ngap Telegram.
  Thang leo muc: 10 (phat hien) -> 12 (diem cao) -> 13 (tai dien) -> 15 (CRITICAL -> Active Response).
  AR = suricata-drop (luat drop inline Suricata) tren agent 003. Rule BAO 100305, 100306, 100311 co ignore=300s;
  100307/100308/100309 (Behavior-IF) khong ignore vi anomaly.py da gom theo su co truoc khi ghi.
  100312 KHONG ignore: nguon con tan cong sau khi lan chan truoc het han thi AR chan lai, moi lan kich hoat
  kem mot the CRITICAL (chot 12/11). Khong dung rule con co ignore de gioi han the: tren Wazuh 4.12 canh bao
  van mang ma 100312 kem nhom cua rule con o moi lan kich hoat (thu ngay 12/11).
-->
<group name="anomaly,ids,">

  <rule id="100300" level="3">
    <field name="module" type="pcre2">^anomaly_(if_rt|web|web_body)$</field>
    <description>Anomaly-IF: canh bao bat thuong tu Isolation Forest</description>
  </rule>

  <rule id="100302" level="10">
    <if_sid>100300</if_sid>
    <field name="module" type="pcre2">^anomaly_web$</field>
    <description>Anomaly - Gia tri tham so bat thuong tren $(host) (query hoac truong ngan POST): nghi injection, vi $(why)</description>
    <group>anomaly_event,anomaly_web,</group>
  </rule>

  <rule id="100303" level="10">
    <if_sid>100300</if_sid>
    <field name="module" type="pcre2">^anomaly_web_body$</field>
    <description>Anomaly - Van ban tu do POST bat thuong tren $(host): nghi XSS luu tru hoac injection, vi $(why)</description>
    <group>anomaly_event,anomaly_web,</group>
  </rule>

  <!-- 100307 | Behavior-IF (module anomaly_if_rt, ca hai chieu). anomaly.py da gom theo su co cua cap may va chi phat khi mo su
       co moi, tang muc do hoac hanh vi doi dang, nen rule BAO thang ra Telegram va KHONG ignore: ignore cua Wazuh tinh cho
       ca rule chu khong theo nguon, se nuot canh bao cua nguon khac. Van thuoc anomaly_event nen gop vao 100311/100312.
       100308 la con duy nhat cua 100307 (mot vi tri tren cay rule, dem mot lan) va nang muc khi diem cao. -->
  <rule id="100307" level="10">
    <if_sid>100300</if_sid>
    <field name="module" type="pcre2">^anomaly_if_rt$</field>
    <description>Anomaly - Hanh vi mang bat thuong (Behavior-IF): $(srcip) -> $(dstip), vi $(why)</description>
    <group>anomaly_event,anomaly_behavior,anomaly_fast,anomaly_notify,</group>
  </rule>

  <!-- 100309 | Behavior-IF phan loai hanh vi tu NGUON DON nguy hiem/gian doan: anomaly.py gan field behavior=brute|flood
       (do mat khau vao dich vu hiem / lam ngap dich vu nen). DAT TRUOC 100308 de canh bao brute/flood (du muc nao) roi
       vao rule nay thay vi chi 100308 -> kich Active Response chan tam. scan (behavior=scan) KHONG khop nen khong chan;
       no la con cua 100307 va van mang anomaly_event nen con gop vao 100311/100312. Kiem lai rule.id khi test. -->
  <rule id="100309" level="12">
    <if_sid>100307</if_sid>
    <field name="behavior" type="pcre2">^(brute|flood)$</field>
    <description>Anomaly - Nghi do mat khau hoac lam ngap tu $(srcip) -> $(dstip) ($(behavior)): chan tam thoi</description>
    <group>anomaly_event,anomaly_behavior,anomaly_fast,anomaly_block,anomaly_notify,</group>
  </rule>

  <rule id="100308" level="12">
    <if_sid>100307</if_sid>
    <field name="severity">high</field>
    <description>Anomaly - Hanh vi mang diem cao (Behavior-IF): $(srcip) -> $(dstip), vi $(why)</description>
    <group>anomaly_event,anomaly_behavior,anomaly_fast,anomaly_high,anomaly_notify,</group>
  </rule>

  <!-- 100304 la con TRUC TIEP cua 100300, khong dat duoi 100302/303: rule co nhieu rule cha nam o nhieu
       vi tri tren cay rule, va Wazuh 4.12 ghi canh bao vao danh sach dem cua 100311/100312 mot lan cho moi
       vi tri, nen voi nhieu rule cha moi canh bao diem cao bi dem nhieu lan (phat hien qua luot chay ngay 12/11).
       Muc 12 cao hon 10 nen Wazuh xet 100304 truoc 100302, 100303. 100304 chi nhan hai module web: canh bao diem cao
       cua Behavior-IF phai di 100307 -> 100308, neu roi vao 100305 se bi ignore=300 cua 100305 nuot. -->
  <rule id="100304" level="12">
    <if_sid>100300</if_sid>
    <field name="module" type="pcre2">^anomaly_(web|web_body)$</field>
    <field name="severity">high</field>
    <description>Anomaly - Bat thuong diem cao ($(module)): $(srcip), vi $(why)</description>
    <group>anomaly_event,anomaly_high,</group>
  </rule>

  <!-- BAO diem cao lan dau, throttle 300s, KHONG dem -->
  <rule id="100305" level="12" ignore="300">
    <if_sid>100304</if_sid>
    <description>Anomaly - Phat hien diem cao tu $(srcip) (bao lan dau): $(why)</description>
    <group>anomaly_notify,</group>
  </rule>

  <!-- 100306 | BAO bat thuong WEB ra Telegram, doc lap voi nhanh hanh vi. -->
  <rule id="100306" level="10" ignore="300">
    <if_sid>100302,100303</if_sid>
    <description>Anomaly - Bat thuong WEB tu $(srcip) tren $(host): $(why)</description>
    <group>anomaly_notify,</group>
  </rule>


  <rule id="100311" level="13" frequency="5" timeframe="300" ignore="300">
    <if_matched_group>anomaly_event</if_matched_group>
    <same_source_ip />
    <description>Anomaly - Nguon $(srcip) tai dien >=5 canh bao bat thuong trong 5 phut</description>
    <group>anomaly_escalation,anomaly_notify,</group>
  </rule>

  <!-- 100312 | KICH HOAT AR va BAO CRITICAL; khong ignore de chan lai duoc khi lan chan truoc het han -->
  <rule id="100312" level="15" frequency="10" timeframe="600">
    <if_matched_group>anomaly_event</if_matched_group>
    <same_source_ip />
    <description>Anomaly CRITICAL - Nguon $(srcip) tai dien dai dang; kich hoat tu dong co lap/chan</description>
    <group>anomaly_critical,anomaly_notify,</group>
  </rule>

</group>
